# .flake8
[flake8]
select = A,B,B9,BLK,C,E,F,I,N,S,W
ignore = E501,W503
max-complexity = 17
max-line-length = 120
application-import-names = scigateway_auth,test
import-order-style = google
per-file-ignores =
    test/**.py:S101
    test/mock_data.py:S105
    test/test_oidc.py:S105, S101
enable-extensions=G
